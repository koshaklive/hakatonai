# --- LLM (LM Studio default) ---
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=lm-studio
LLM_MODEL=qwen3.5-9b
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024
LLM_TIMEOUT=120
LLM_RETRIES=3
LLM_CONTEXT_TOKENS=8192
# json_schema | json_object | prompt
LLM_JSON_MODE=json_schema
# Extra request body to disable thinking. LM Studio ignores it for Qwen3.5 (see README),
# but vLLM/llama.cpp honour it. Ollama: {"reasoning_effort":"none"}
LLM_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}
# Append " /no_think" to last user message (Qwen3 only, NOT Qwen3.5)
LLM_NO_THINK_SUFFIX=0

# --- Switch backend by .env only ---
# Ollama: LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=qwen3:8b
# vLLM:   LLM_BASE_URL=http://localhost:8000/v1   LLM_MODEL=Qwen/Qwen3-8B

# --- Embeddings (CPU) ---
EMB_MODEL=BAAI/bge-m3
EMB_DEVICE=cpu
EMB_BATCH=16
EMB_CACHE_DIR=.cache/emb
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# --- Prompts / RAG limits ---
PROMPT_VERSION=v1
MAX_FRAGMENTS=5

# --- data / index ---
DATA_FILE=data/corpus_chunks.json
INDEX_DIR=indexes
QDRANT_PATH=./qdrant_data
USE_QDRANT=1
DENSE=1
RERANK=0
ANCHORS_FILE=anchors.yaml
# --- retrieval ---
DENSE_K=20
BM25_K=0
RRF_K=60
RERANK_POOL=0
FRAGMENT_LIMIT=5
RELATED_MAX=2
ANCHOR_MAX=2
CORE_MIN=2
REL_W_DENSE=0.7
REL_W_BM25=0.3
REL_THRESHOLD=0.574       # set by calibrate.py (stage 2)
ABBR_MIN_DF=2
QUERY_MAX_LEN=1000
# --- PocketBase / auth ---
PB_URL=http://localhost:8090
PB_SERVICE_EMAIL=backend@test.local
PB_SERVICE_PASSWORD=
AUTH_MODE=pocketbase      # dev = skip JWT check (local debugging only)
AUTH_CACHE_TTL=30
INGEST_KEY=               # shared secret for the PocketBase hook (header X-Ingest-Key)
# --- embeddings (CPU) ---
EMB_MODEL=BAAI/bge-m3
EMB_DEVICE=cpu

DATA_FILE=data/instruction_chunks.json

